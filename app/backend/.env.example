PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://app:app@localhost:5432/app_db

# Required only when using Sally browser-automation features.
SALLY_EMAIL=
SALLY_PASSWORD=

# Sally collects a bare Knox ID in question 1 and leaves its own Email column blank, but applicants
# are identified by email and letters are delivered there. Set the corporate mail domain so a Knox
# ID can be expanded into an address (e.g. samsung.com turns "gildong.hong" into
# "gildong.hong@samsung.com"). Leave blank and Sally rows whose Knox ID has no domain are flagged
# as errors rather than given a guessed address.
KNOX_EMAIL_DOMAIN=

# Email sending. Switch to EMAIL_PROVIDER=knox_portal once KNOX_PORTAL_API_URL below is filled in.
EMAIL_PROVIDER=gmail
GMAIL_USER=
# Gmail App Password (requires Google Account 2FA), not the account login password.
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Program Team

# Knox Portal email provider (token/account based). Leave KNOX_PORTAL_API_URL blank until the
# internal office endpoint is available — selecting EMAIL_PROVIDER=knox_portal fails fast with a
# clear error until all three of these are set.
KNOX_PORTAL_API_URL=
KNOX_PORTAL_API_TOKEN=
KNOX_PORTAL_ACCOUNT=

# Access control. The application never stores or checks passwords — authentication is delegated
# to the corporate SSO / reverse proxy, and the app performs authorization (roles) only.
#   disabled   — no access control; every request is treated as an admin (previous behaviour,
#                kept as the default so existing deployments keep working). Logs a startup warning.
#   dev_header — identity from an unverified X-Dev-User-Email header. Local development only.
#   sso_header — identity from proxy-injected headers. ONLY safe when the backend is reachable
#                exclusively through the proxy AND the proxy strips these headers from client
#                requests; otherwise anyone can impersonate anyone.
AUTH_PROVIDER=disabled
# Header names are a best-guess placeholder — confirm against the real SSO gateway before enabling.
AUTH_SSO_EMAIL_HEADER=X-Forwarded-Email
AUTH_SSO_USER_HEADER=X-Forwarded-User
AUTH_SSO_NAME_HEADER=X-Forwarded-DisplayName
# Comma-separated emails always granted admin and auto-provisioned on first sign-in, so a fresh
# deployment is never locked out. Keep this short and remove entries once real admins exist.
AUTH_BOOTSTRAP_ADMINS=

# AI features. This is the operator-level gate: `disabled` (default) means no LLM call is ever
# made, whatever the in-app AI toggles say. Which features may use AI is configured separately in
# the app's Organization Settings page.
#
#   disabled — AI off entirely (default; app behaves exactly as it did before AI was added)
#   claude   — public Anthropic API; needs ANTHROPIC_API_KEY
#   openai   — public OpenAI API; needs OPENAI_API_KEY
#   ai_pro   — internal AI Pro gateway; needs AI_PRO_API_URL + AI_PRO_API_TOKEN
#
# claude and openai send data outside the corporate network, so use them for development with
# SYNTHETIC data only. Real applicant data belongs on ai_pro.
LLM_PROVIDER=disabled

# Optional model override. Defaults per provider: claude-opus-4-8 (claude), gpt-4o (openai).
LLM_MODEL=

# --- claude provider ---
# Get a key at https://console.anthropic.com → API Keys. This is separate from a claude.ai
# subscription and is billed per use.
ANTHROPIC_API_KEY=

# --- openai provider ---
# Get a key at https://platform.openai.com/api-keys.
OPENAI_API_KEY=
# Only needed to point at a compatible gateway instead of api.openai.com.
OPENAI_BASE_URL=

# --- ai_pro provider (internal) ---
# Leave AI_PRO_API_URL blank until the internal endpoint is available — selecting
# LLM_PROVIDER=ai_pro fails fast with a clear error until both of these are set.
# See docs/ai-pro-integration-checklist.md for what to confirm before enabling this.
AI_PRO_API_URL=
AI_PRO_API_TOKEN=

# Deferred integration (DESIGN.md §9)
CONFLUENCE_API_BASE_URL=
CONFLUENCE_API_TOKEN=
